# Copy this file to terraform.tfvars (gitignored — see .gitignore / ADR 0003)
# and fill in your own values. terraform.tfvars is never committed.

region = "us-ashburn-1" # tenancy's home region; required, no default (R7)

tenancy_ocid     = "ocid1.tenancy.oc1..aaaaaaaaexampletenancyocidxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
user_ocid        = "ocid1.user.oc1..aaaaaaaaexampleuserocidxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
fingerprint      = "aa:bb:cc:dd:ee:ff:00:11:22:33:44:55:66:77:88:99"
private_key_path = "~/.oci/oci_api_key.pem"
compartment_ocid = "ocid1.compartment.oc1..aaaaaaaaexamplecompartmentocidxxxxxxxxxxxxxxxxxxxxxxxxxxx"

# Placeholder only — never commit a real email address (ADR 0003).
budget_alert_email_address = "alerts@example.com"

# Optional: node-pool sizing. Defaults to 2 nodes, which the current workload
# needs. Every node past the first is billed: Always Free A1 covers 2 OCPU /
# 12 GB, one node at this config's per-node sizing.
#
# Uncomment worker_node_count to change how many nodes run. Uncomment
# stay_within_free_tier to pin the pool to the free allowance instead, which
# overrides the count to 1 -- do that only after trimming at least two pods,
# since one node caps the cluster at 31 and the workload measures 33.
# worker_node_count     = 2
# stay_within_free_tier = true

# Optional (R14): CIDRs allowed to open sessions against the managed OCI Bastion.
# Defaults to ["0.0.0.0/0"] — see oci-bastion.tf for why that's a deliberate,
# defense-in-depth-gated default. Uncomment and narrow to your static IP/CIDR
# once one is available.
# bastion_allowed_cidr_blocks = ["203.0.113.4/32"]
